{
  "info": {
    "name": "Uniblox Checkout API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the Storefront folder top to bottom. Each request saves the ids the next one needs."
  },
  "item": [
    {
      "name": "Storefront",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create cart",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"cartId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add keyboard x2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"p_keyboard\",\n  \"quantity\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add mouse pad x1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"p_mousepad\",\n  \"quantity\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Set keyboard quantity to 3",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/items/p_keyboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "items",
                "p_keyboard"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove mouse pad",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/items/p_mousepad",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "items",
                "p_mousepad"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "View cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Checkout (with Idempotency-Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "description": "First call returns 201. Run it again to see the 200 replay with the same order."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"orderId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Checkout again (replay, same key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"replay header\", () => pm.response.to.have.header(\"Idempotent-Replayed\", \"true\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Checkout with coupon",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"couponCode\": \"{{couponCode}}\"\n}"
            },
            "description": "Use on a fresh cart (create one, add items first) after generating a coupon."
          }
        },
        {
          "name": "Simulate declined payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Simulate-Payment",
                "value": "decline"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{cartId}}/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{cartId}}",
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "description": "Expect 402 PAYMENT_DECLINED, cart stays open."
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Generate coupon",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/coupons/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "coupons",
                "generate"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"couponCode\", pm.response.json().code); }",
                  "pm.test(\"201 or 409\", () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "List coupons",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "coupons"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/report",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "report"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Ops",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
